# Shared constants for scripts/build.sh and scripts/build.ps1. Plain KEY=VALUE
# lines: bash sources this file, PowerShell parses it line by line. Keep it free
# of quoting, expansion and logic.
PYAPP_VER=v0.29.0
PYAPP_PYTHON_VERSION=3.11
PYAPP_EXEC_SPEC=deepreefmap.bootstrap:main
BASE_FEATURES=loger,gopro
TORCH_INDEX_cu126=https://download.pytorch.org/whl/cu126
TORCH_INDEX_cu130=https://download.pytorch.org/whl/cu130
TORCH_INDEX_rocm=https://download.pytorch.org/whl/rocm6.4
